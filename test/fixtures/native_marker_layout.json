      {"name": "-3/128 向远离零进位", "kind": "length", "input": -0.0234375, "units": -2},
      {"name": "1/256 不到一半，舍去", "kind": "length", "input": 0.00390625, "units": 0},
      {"name": "-1/256 不到一半，舍去", "kind": "length", "input": -0.00390625, "units": 0},
      {"name": "1e-9 视为 0", "kind": "length", "input": 1e-9, "units": 0},
